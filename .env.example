# Copy to .env and fill in what you use. Every variable is optional except the key for
# the provider you pick.

# Which provider the app starts on (gemini, openrouter, openai, anthropic,
# azure_openai, azure_anthropic)
CPA_PROVIDER=gemini
CPA_TIMEOUT_SECONDS=120
CPA_MAX_TOKENS=8192
CPA_API_HOST=127.0.0.1
CPA_API_PORT=8000

# Gemini. Extra keys (_2 .. _9) are tried in order on quota/auth errors.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=

# OpenRouter (extra keys _2 .. _9 work here too)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_REQUIRE_PARAMETERS=false
OPENROUTER_ROUTING=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
OPENROUTER_RETRY_BUDGET_SECONDS=45

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Azure AI Foundry: one resource, shared by azure_openai and azure_anthropic
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_ANTHROPIC_MODEL=
