# Optional environment-level secrets. Project Settings can store local keys in .system/config.yaml.
GEMINI_API_KEY   = 
GEMINI_API_KEY_2 =
GEMINI_API_KEY_3 =
GEMINI_API_KEY_4 =
GEMINI_API_KEY_5 =

OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Azure AI Foundry: one resource, shared by azure_openai and azure_anthropic
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

CHAT_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL=openrouter/free

JWT_SECRET=
PROJECTS_ROOT=./projects
MAX_AGENT_STEPS=16

# Max source characters per compiler call (all providers except Gemini)
COMPILER_SEGMENT_CHARS=8000

# Same, but for Gemini only. Lower = more, smaller calls.
COMPILER_SEGMENT_CHARS_GEMINI=4000

# Output-token ceiling for compiler calls (used by OpenRouter and Anthropic/Azure Anthropic)
COMPILER_MAX_OUTPUT_TOKENS=15000

# Second pass that recovers source details the model dropped. Set to 0 to turn it off.
COMPILER_GAP_FILL=1